{
  "name": "eticket-war",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "worker": "node --env-file=.env --import tsx scripts/worker.ts",
    "migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "seed": "node --env-file=.env --import tsx scripts/seed.ts",
    "keys": "node --import tsx scripts/gen-keys.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "reconcile": "node --env-file=.env --import tsx scripts/worker.ts reconcile",
    "qa": "node --env-file=.env --import tsx scripts/qa-concurrency.ts"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "ioredis": "^6.0.0",
    "jsqr": "^1.4.0",
    "next": "^16.4.0",
    "nodemailer": "^10.0.16",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "undici": "^8.11.2",
    "vitest": "^5.0.3"
  }
}
