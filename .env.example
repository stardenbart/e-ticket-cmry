# --- Infra (lihat docker-compose.yml) ---
DATABASE_URL=postgres://eticket:eticket@localhost:5440/eticket
REDIS_URL=redis://localhost:6390
APP_URL=http://localhost:3100

# --- Secrets (di produksi: secret manager) ---
# HMAC untuk hash nomor identitas & OTP (min 32 byte acak)
IDENTITY_HMAC_SECRET=change-me
# HMAC untuk admission token waiting room & enkripsi manifest scanner
APP_SECRET=change-me
# Kunci Ed25519 penanda tangan QR. Jalankan `npm run keys` untuk membuat.
QR_ACTIVE_KID=1
QR_PRIVATE_KEY_1=
QR_PUBLIC_KEY_1=

# --- Email (SMTP; Mailpit di lokal, SES/Postmark/Resend SMTP di produksi) ---
SMTP_HOST=localhost
SMTP_PORT=1030
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="E-Ticket Gathering <no-reply@eticket.local>"
ADMIN_ALERT_EMAIL=admin@eticket.local

# --- Cloudflare Turnstile (nilai di bawah = test key yang selalu lolos) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
